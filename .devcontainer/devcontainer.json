{
  "name": "剧集猎人 SeriesHunter",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [
    8787
  ],
  "portsAttributes": {
    "8787": {
      "label": "series-hunter",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh || true",
  "postStartCommand": "nohup bash .devcontainer/run.sh > /tmp/series-hunter.log 2>&1 &",
  "stopInterval": "360",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "shutdownAction": "stopContainer"
}